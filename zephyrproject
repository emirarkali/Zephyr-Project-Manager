        if [[ -n "$found_sdk" ]]; then
            if [[ -f "$found_sdk/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb" ]]; then
                DYNAMIC_GDB_PATH="$found_sdk/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
            elif [[ -f "$found_sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb" ]]; then
                DYNAMIC_GDB_PATH="$found_sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
            fi
        fi
    fi

    cat > "$destination/.vscode/launch.json" <<EOF_LAUNCH
