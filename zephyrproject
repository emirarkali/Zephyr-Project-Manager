#!/usr/bin/env bash

set -Eeuo pipefail

# ============================================================
# Zephyr Project Helper
# ============================================================

# ------------------------------------------------------------
# Settings
# ------------------------------------------------------------

ZEPHYR_WORKSPACE="${ZEPHYR_WORKSPACE:-$HOME/zephyrproject}"
APPLICATIONS_DIR="${ZEPHYR_APPLICATIONS_DIR:-$ZEPHYR_WORKSPACE/applications}"
ZEPHYR_VENV="${ZEPHYR_VENV:-$ZEPHYR_WORKSPACE/.venv}"

BUILD_DIR="${ZEPHYR_BUILD_DIR:-build}"

PROJECT_DIR="$PWD"

# ------------------------------------------------------------
# Colors
# ------------------------------------------------------------

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

info()
{
    echo -e "${BLUE}[INFO]${NC} $*"
}

success()
{
    echo -e "${GREEN}[OK]${NC} $*"
}

warning()
{
    echo -e "${YELLOW}[WARNING]${NC} $*"
}

error()
{
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

question()
{
    echo -en "${CYAN}[?]${NC} $*"
}

# ------------------------------------------------------------
# Error handling
# ------------------------------------------------------------

on_error()
{
    local exit_code=$?
    local line_number=$1

    error "Operation failed."
    error "Line: $line_number"
    error "Exit code: $exit_code"

    exit "$exit_code"
}

trap 'on_error $LINENO' ERR

# ------------------------------------------------------------
# Help
# ------------------------------------------------------------

show_help()
{
    cat <<'EOF'

Zephyr Project Helper

Usage:

  zephyrproject -newproject "project-name"
      Creates a new minimal Zephyr project from scratch.
      Board selection is interactive.
      If board is not selected, board.txt is left empty and no build is performed.

  zephyrproject -copy "source-project" "new-project"
