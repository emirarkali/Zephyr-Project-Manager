EOF

    # ========================================================
    # VS CODE LAUNCH
    # ========================================================

    local DYNAMIC_GDB_PATH="\${env:HOME}/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
    if [[ -n "${ZEPHYR_SDK_INSTALL_DIR:-}" ]]; then
        DYNAMIC_GDB_PATH="${ZEPHYR_SDK_INSTALL_DIR}/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
    else
        local found_sdk="$(ls -d $HOME/zephyr-sdk* 2>/dev/null | sort -rV | head -n 1)"
        if [[ -n "$found_sdk" ]]; then
            if [[ -f "$found_sdk/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb" ]]; then
                DYNAMIC_GDB_PATH="$found_sdk/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
