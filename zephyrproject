stop_old_openocd()
{
    if pgrep -x openocd >/dev/null 2>&1; then

        warning "Closing old OpenOCD process..."

        pkill -x openocd || true
        sleep 1
    fi

    if pgrep -f '[o]penocd.*interface/stlink' >/dev/null 2>&1; then

        warning "Closing old OpenOCD process using ST-Link..."

        pkill -f '[o]penocd.*interface/stlink' || true
        sleep 1
    fi
}

# ============================================================
# BUILD CHECKS
# ============================================================

check_build_output()
{
    if [[ ! -f "$PROJECT_DIR/$BUILD_DIR/zephyr/zephyr.elf" ]]; then

        error "Build output not found:"
        error "$PROJECT_DIR/$BUILD_DIR/zephyr/zephyr.elf"
        error "Perform build operation first."

        exit 1
    fi
}

check_debug_tools()
{
    if ! command -v openocd >/dev/null 2>&1; then

        warning "OpenOCD not found in system PATH."
        warning "West can use OpenOCD within the Zephyr SDK."
    fi
}

# ============================================================
# BUILD
# ============================================================

run_build()
{
    local pristine_mode="${1:-normal}"

    local board
    board="$(get_board)"

    # --------------------------------------------------------
    # Board required
    # --------------------------------------------------------

    if [[ -z "$board" ]]; then

        error "Board not selected."
        error
        error "board.txt file is empty:"
        error "$PROJECT_DIR/board.txt"
        error
        error "Example:"
        error "echo 'nucleo_f303re' > board.txt"

        exit 1
    fi

    # --------------------------------------------------------
    # west build arguments
    # --------------------------------------------------------

    local args=(
        west
        build
        --build-dir "$PROJECT_DIR/$BUILD_DIR"
    )

    if [[ "$pristine_mode" == "clean" ]]; then
        args+=(-p always)
    fi

    args+=(
        -b "$board"
        "$PROJECT_DIR"
    )

    # --------------------------------------------------------
    # Add BOARD_ROOT if custom boards exist
    # --------------------------------------------------------

    if [[ -d "$PROJECT_DIR/boards" ]] &&
       [[ -n "$(find "$PROJECT_DIR/boards" -mindepth 1 -print -quit 2>/dev/null)" ]]; then

        info "Local boards/ content found."
        info "BOARD_ROOT active."

        args+=(
            --
            "-DBOARD_ROOT=$PROJECT_DIR"
        )
    fi

    echo
    info "Board        : $board"
    info "Project        : $PROJECT_DIR"
    info "Build directory: $PROJECT_DIR/$BUILD_DIR"
    echo

    "${args[@]}"

    check_build_output

    success "Build completed."
}

# ============================================================
# FLASH
# ============================================================

run_flash()
{
    stop_old_openocd

    check_build_output
    check_debug_tools

    info "Flashing board..."

    west flash \
        --build-dir "$PROJECT_DIR/$BUILD_DIR" \
        -r openocd

    success "Flash completed."
}

# ============================================================
# DEBUG
# ============================================================

run_debug()
{
    stop_old_openocd

    check_build_output
    check_debug_tools

    info "Starting console debug..."
    info "To exit, type quit in GDB"

    west debug \
        --build-dir "$PROJECT_DIR/$BUILD_DIR" \
        -r openocd
}

# ============================================================
# DEBUG SERVER
# ============================================================

run_debugserver()
{
    stop_old_openocd

    check_build_output
    check_debug_tools

    info "Starting OpenOCD debug server."
    info "GDB: localhost:3333"
    info "Ctrl+C to stop."

    west debugserver \
        --build-dir "$PROJECT_DIR/$BUILD_DIR" \
        -r openocd
}

# ============================================================
# STATUS
# ============================================================

show_status()
{
    echo
    echo "============================================================"
    echo "Zephyr Project Status"
    echo "============================================================"
    echo

    echo "Project        : $PROJECT_DIR"
    echo "Workspace      : $ZEPHYR_WORKSPACE"
    echo "Applications   : $APPLICATIONS_DIR"
    echo "Venv           : $ZEPHYR_VENV"
    echo "Board          : $(get_board)"
    echo "Build directory: $PROJECT_DIR/$BUILD_DIR"

    echo

    if [[ -f "$PROJECT_DIR/$BUILD_DIR/zephyr/zephyr.elf" ]]; then

        success "zephyr.elf exists."

        ls -lh "$PROJECT_DIR/$BUILD_DIR/zephyr/zephyr.elf"

    else

        warning "zephyr.elf not found."
    fi

    echo

    if pgrep -a -f '[o]penocd' >/dev/null 2>&1; then

        warning "Running OpenOCD process exists:"

        pgrep -a -f '[o]penocd'

    else

        success "No running OpenOCD process."
