#!/usr/bin/env bash

set -Eeuo pipefail

# ============================================================
# Zephyr Project Helper
# ============================================================

# ------------------------------------------------------------
# Settings
# ------------------------------------------------------------

ZEPHYR_WORKSPACE="${ZEPHYR_WORKSPACE:-$HOME/zephyrproject}"
APPLICATIONS_DIR="${ZEPHYR_APPLICATIONS_DIR:-$ZEPHYR_WORKSPACE/applications}"
ZEPHYR_VENV="${ZEPHYR_VENV:-$ZEPHYR_WORKSPACE/.venv}"

BUILD_DIR="${ZEPHYR_BUILD_DIR:-build}"

PROJECT_DIR="$PWD"

# ------------------------------------------------------------
# Colors
# ------------------------------------------------------------

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

info()
{
    echo -e "${BLUE}[INFO]${NC} $*"
}

success()
{
    echo -e "${GREEN}[OK]${NC} $*"
}

warning()
{
    echo -e "${YELLOW}[WARNING]${NC} $*"
}

error()
{
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

question()
{
    echo -en "${CYAN}[?]${NC} $*"
}

# ------------------------------------------------------------
# Error handling
# ------------------------------------------------------------

on_error()
{
    local exit_code=$?
    local line_number=$1

    error "Operation failed."
    error "Line: $line_number"
    error "Exit code: $exit_code"

    exit "$exit_code"
}

trap 'on_error $LINENO' ERR

# ------------------------------------------------------------
# Help
# ------------------------------------------------------------

show_help()
{
    cat <<'EOF'

Zephyr Project Helper

Usage:

  zephyrproject -newproject "project-name"
      Creates a new minimal Zephyr project from scratch.
      Board selection is interactive.
      If board is not selected, board.txt is left empty and no build is performed.

  zephyrproject -copy "source-project" "new-project"
      Copies an existing project.
      build/ folder is removed from the copy.
      Board can be kept, changed or left empty.

  zephyrproject -openproject "project-name"
      Opens the project in Applications with VS Code.
      Performs a clean build if board exists.

  zephyrproject -install-completion
      Installs bash tab auto-completion for this script.

  zephyrproject -export "project-name"
      Exports the project to a .tar.gz archive, excluding the build folder.

  zephyrproject -monitor
      Automatically detects and opens the serial port monitor (115200 baud).

  zephyrproject -delete "project-name"
      Deletes the specified project from the Applications folder.

  zephyrproject -show
      Lists projects in the Applications directory.

  zephyrproject -build
      Performs a normal build.

  zephyrproject -clean
      Performs a pristine build.

  zephyrproject -flash
      Builds and flashes to the board.

  zephyrproject -clean-flash
      Performs pristine build and flashes to the board.

  zephyrproject -flash-only
      Flashes existing build output.

  zephyrproject -debug
      Builds and starts GDB debug.

  zephyrproject -debugserver
      Builds and starts OpenOCD GDB server.

  zephyrproject -menuconfig
      Opens the Zephyr menuconfig interface.

  zephyrproject -pristine
      Completely deletes the build folder.

  zephyrproject -status
      Shows project, board, and tool status.

  zephyrproject -help
      Shows this help screen.


Example:

  zephyrproject -newproject uart_test

  zephyrproject -copy uart_test uart_test_v2

  zephyrproject -build

  zephyrproject -flash

  zephyrproject -clean-flash

EOF
}

# ------------------------------------------------------------
# General checks
# ------------------------------------------------------------

check_command()
{
    local command_name="$1"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        error "Required command not found: $command_name"
        exit 1
    fi
}


sync_launch_json()
{
    if [[ -f "$PROJECT_DIR/.vscode/launch.json" ]]; then
        local b="$(get_board)"
        if [[ -n "$b" ]]; then
            sed -i "s/"device": ".*"/"device": "$b"/" "$PROJECT_DIR/.vscode/launch.json"
        fi
    fi
}

check_project()
{
    if [[ ! -f "$PROJECT_DIR/CMakeLists.txt" ]]; then
        error "CMakeLists.txt not found in this folder:"
        error "$PROJECT_DIR"
        error "Run the command in the Zephyr application root folder."
        exit 1
    fi

    if [[ ! -d "$PROJECT_DIR/src" ]]; then
        error "src folder not found:"
        error "$PROJECT_DIR/src"
        exit 1
    fi

    if [[ ! -f "$PROJECT_DIR/src/main.c" ]]; then
        warning "src/main.c not found."
    fi

    if [[ ! -f "$PROJECT_DIR/prj.conf" ]]; then
        warning "prj.conf not found."
    fi

    if [[ ! -f "$PROJECT_DIR/board.txt" ]]; then
        warning "board.txt not found."
    fi

    sync_launch_json
}

# ------------------------------------------------------------
# Zephyr virtual environment
# ------------------------------------------------------------

activate_venv()
{
    if [[ ! -f "$ZEPHYR_VENV/bin/activate" ]]; then
        error "Zephyr virtual environment not found:"
        error "$ZEPHYR_VENV/bin/activate"
        exit 1
    fi

    # shellcheck disable=SC1090
    source "$ZEPHYR_VENV/bin/activate"

    if ! command -v west >/dev/null 2>&1; then
        error "Virtual environment activated but west not found."
        exit 1
    fi
}

# ============================================================
# BOARD MANAGEMENT
# ============================================================

# ------------------------------------------------------------
# Read board.txt
# ------------------------------------------------------------

get_board()
{
    if [[ -f "$PROJECT_DIR/board.txt" ]]; then
        tr -d '[:space:]' < "$PROJECT_DIR/board.txt"
    else
        echo ""
    fi
}

# ------------------------------------------------------------
# Write board to board.txt
# ------------------------------------------------------------

write_board()
{
    local project="$1"
    local board="$2"

    printf '%s\n' "$board" > "$project/board.txt"
}

# ------------------------------------------------------------
# Is board known by Zephyr?
# ------------------------------------------------------------

board_exists()
{
    local board="$1"

    [[ -n "$board" ]] || return 1

    west boards -f "{name}" 2>/dev/null |
        sed '/^[[:space:]]*$/d' |
        grep -Fx -- "$board" >/dev/null
}

# ------------------------------------------------------------
# Show similar board names
# ------------------------------------------------------------

show_similar_boards()
{
    local board="$1"

    echo
    info "Similar Zephyr board names:"

    west boards -f "{name}" 2>/dev/null |
        grep -i -- "$board" |
        head -n 10 || true

    echo
}

# ------------------------------------------------------------
# Select board for new project
# ------------------------------------------------------------

select_board_for_new_project()
{
    local destination="$1"
    local board=""

    echo
    echo "------------------------------------------------------------"
    echo "Board Selection"
    echo "------------------------------------------------------------"
    echo
    echo "Enter Zephyr board name."
    echo
    echo "Example:"
    echo "  nucleo_f303re"
    echo "  nucleo_f303k8"
    echo
    echo "To configure the board manually later:"
    echo "  q"
    echo

    while true; do

        question "Board: "
        read -r board

        board="${board//[[:space:]]/}"

        if [[ "$board" == "q" || "$board" == "Q" ]]; then

            : > "$destination/board.txt"

            warning "Board selection skipped."
            warning "board.txt left empty."

            return 0
        fi

        if [[ -z "$board" ]]; then
            warning "Board name cannot be empty."
            warning "Type q to skip and configure manually."
            continue
        fi

        info "Checking board in Zephyr list..."

        if board_exists "$board"; then

            write_board "$destination" "$board"

            success "Board found: $board"
            return 0

        else

            error "This board was not found in Zephyr:"
            error "$board"

            show_similar_boards "$board"

            warning "Enter board name again or type q for manual configuration."
        fi
    done
}

# ------------------------------------------------------------
# Select board for copied project
# ------------------------------------------------------------

select_board_for_copied_project()
{
    local destination="$1"
    local old_board=""
    local board=""

    if [[ -f "$destination/board.txt" ]]; then
        old_board="$(tr -d '[:space:]' < "$destination/board.txt")"
    fi

    echo
    echo "------------------------------------------------------------"
    echo "Board Selection"
    echo "------------------------------------------------------------"
    echo

    if [[ -n "$old_board" ]]; then
        echo "Board in source project:"
        echo
        echo "  $old_board"
        echo
    else
        echo "No board selected in source project."
        echo
    fi

    echo "Options:"
    echo
    echo "  k            Keep the old board"
    echo "  q            Leave board.txt empty"
    echo "  <board name>  Select a new Zephyr board"
    echo

    while true; do

        question "Board Selection: "
        read -r board

        board="${board//[[:space:]]/}"

        # ----------------------------------------------------
        # Keep old board
        # ----------------------------------------------------

        if [[ "$board" == "k" || "$board" == "K" ]]; then

            if [[ -z "$old_board" ]]; then
                warning "No board to keep in source project."
                continue
            fi

            success "Keeping board: $old_board"
            return 0
        fi

        # ----------------------------------------------------
        # Leave board empty
        # ----------------------------------------------------

        if [[ "$board" == "q" || "$board" == "Q" ]]; then

            : > "$destination/board.txt"

            warning "board.txt left empty."
            return 0
        fi

        # ----------------------------------------------------
        # Empty input
        # ----------------------------------------------------

        if [[ -z "$board" ]]; then
            warning "Enter a board name, k or q."
            continue
        fi

        # ----------------------------------------------------
        # Verify new Zephyr board
        # ----------------------------------------------------

        info "Checking board in Zephyr list..."

        if board_exists "$board"; then

            write_board "$destination" "$board"

            success "New board selected: $board"
            return 0

        else

            error "This board was not found in Zephyr:"
            error "$board"

            show_similar_boards "$board"

            warning "Try again."
        fi
    done
}

# ============================================================
# PROJECT NAME
# ============================================================

validate_project_name()
{
    local LC_ALL=C
    local project_name="$1"

    if [[ -z "$project_name" ]]; then
        error "Project name not specified."
        exit 1
    fi

    if [[ "$project_name" == "." || "$project_name" == ".." ]]; then
        error "Invalid project name: $project_name"
        exit 1
    fi

    if [[ "$project_name" == */* ]]; then
        error "Project name cannot contain folder paths."
        error "Enter only the project name."
        exit 1
    fi

    if [[ ! "$project_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
        error "Invalid project name:"
        error "$project_name"
        error "Only letters, numbers, underscores and hyphens are allowed."
        exit 1
    fi
}

# ------------------------------------------------------------
# Change CMake project(...) name
# ------------------------------------------------------------

update_cmake_project_name()
{
    local cmake_file="$1"
    local project_name="$2"
    local cmake_project_name

    cmake_project_name="${project_name//-/_}"

    if grep -Eq '^[[:space:]]*project\(' "$cmake_file"; then

        sed -i -E \
            "s/^[[:space:]]*project\([^)]*\)/project($cmake_project_name)/" \
            "$cmake_file"

    else
        warning "project(...) not found in CMakeLists.txt."
    fi
}

# ============================================================
# NEW PROJECT
# ============================================================

create_new_project()
{
    local project_name="$1"
    local destination="$APPLICATIONS_DIR/$project_name"
    local cmake_project_name="${project_name//-/_}"

    validate_project_name "$project_name"

    check_command mkdir
    check_command cat

    if [[ ! -d "$APPLICATIONS_DIR" ]]; then
        error "Applications folder not found:"
        error "$APPLICATIONS_DIR"
        exit 1
    fi

    if [[ -e "$destination" ]]; then
        error "A file or folder with this name already exists:"
        error "$destination"
        exit 1
    fi

    # West is required for board check
    activate_venv

    info "Creating new Zephyr project..."
    info "Target: $destination"

    # --------------------------------------------------------
    # Folders
    # --------------------------------------------------------

    mkdir -p "$destination/src"
    mkdir -p "$destination/boards"
    mkdir -p "$destination/.vscode"

    # --------------------------------------------------------
    # CMakeLists.txt
    # --------------------------------------------------------

    cat > "$destination/CMakeLists.txt" <<EOF
cmake_minimum_required(VERSION 3.20.0)

find_package(Zephyr REQUIRED HINTS \$ENV{ZEPHYR_BASE})

project($cmake_project_name)

target_sources(app PRIVATE
    src/main.c
)
EOF

    # --------------------------------------------------------
    # prj.conf
    # --------------------------------------------------------

    cat > "$destination/prj.conf" <<'EOF'
# ============================================================
# Zephyr Project Configuration
# ============================================================

# Console / printk
CONFIG_PRINTK=y

# Assertions
CONFIG_ASSERT=y

# Logging
CONFIG_LOG=y
CONFIG_LOG_DEFAULT_LEVEL=3

# Main thread stack
CONFIG_MAIN_STACK_SIZE=2048

# ------------------------------------------------------------
# Add project-specific configuration below
# ------------------------------------------------------------
EOF

    # --------------------------------------------------------
    # app.overlay
    # --------------------------------------------------------

    cat > "$destination/app.overlay" <<'EOF'
/*
 * Zephyr Devicetree Overlay
 *
 * Add project-specific devicetree configuration here.
 */
EOF

    # --------------------------------------------------------
    # board.txt
    #
    # MUST be created from scratch in every new project.
    # --------------------------------------------------------

    : > "$destination/board.txt"

    # --------------------------------------------------------
    # main.c
    # --------------------------------------------------------

    cat > "$destination/src/main.c" <<'EOF'
#include <zephyr/kernel.h>
#include <zephyr/sys/printk.h>

int main(void)
{
    printk("Zephyr application started.\n");

    while (1) {

        /*
         * Application code
         */

        k_sleep(K_SECONDS(1));
    }

    return 0;
}
EOF

    # --------------------------------------------------------
    # .gitignore
    # --------------------------------------------------------

    cat > "$destination/.gitignore" <<'EOF'
build/
.vscode/*.log
*.swp
*~
EOF

    # ========================================================
    # VS CODE TASKS
    # ========================================================

    cat > "$destination/.vscode/tasks.json" <<'EOF'
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Zephyr: Build",
            "type": "shell",
            "command": "zephyrproject",
            "args": [
                "-build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Zephyr: Clean Build",
            "type": "shell",
            "command": "zephyrproject",
            "args": [
                "-clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Zephyr: Flash",
            "type": "shell",
            "command": "zephyrproject",
            "args": [
                "-flash-only"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Build and Flash",
            "type": "shell",
            "command": "zephyrproject",
            "args": [
                "-flash"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Clean Build and Flash",
            "type": "shell",
            "command": "zephyrproject",
            "args": [
                "-clean-flash"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Start OpenOCD Server",
            "type": "shell",
            "command": "zephyrproject",
            "args": [
                "-debugserver"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "openocd",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Open On-Chip Debugger",
                    "endsPattern": "Listening on port 3333 for gdb connections"
                }
            }
        }
    ]
