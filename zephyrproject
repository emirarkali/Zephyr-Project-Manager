# ============================================================
# COPY PROJECT
# ============================================================

copy_existing_project()
{
    local src_name="$1"
    local dst_name="$2"

    local src_dir="$APPLICATIONS_DIR/$src_name"
    local dst_dir="$APPLICATIONS_DIR/$dst_name"

    validate_project_name "$dst_name"

    check_command cp
    check_command sed
    check_command mkdir

    if [[ ! -d "$src_dir" ]]; then
        error "Source project not found:"
        error "$src_dir"
        exit 1
    fi

    if [[ -e "$dst_dir" ]]; then
        error "A file or folder with this name already exists:"
        error "$dst_dir"
        exit 1
    fi

    activate_venv

    info "Copying project..."
    info "Source: $src_dir"
    info "Target:  $dst_dir"

    mkdir -p "$dst_dir"

    # --------------------------------------------------------
    # Copy all project files
    # --------------------------------------------------------

    shopt -s dotglob
    cp -a "$src_dir/." "$dst_dir/"
    shopt -u dotglob

    # --------------------------------------------------------
    # Remove old build output
    # --------------------------------------------------------

    if [[ -d "$dst_dir/$BUILD_DIR" ]]; then

        info "Removing copied build folder..."

        rm -rf -- "$dst_dir/$BUILD_DIR"
    fi

    # --------------------------------------------------------
    # Change CMake project name
    # --------------------------------------------------------

    if [[ -f "$dst_dir/CMakeLists.txt" ]]; then

        update_cmake_project_name \
            "$dst_dir/CMakeLists.txt" \
            "$dst_name"

    else

        warning "CMakeLists.txt not found:"
        warning "$dst_dir/CMakeLists.txt"
    fi

    # --------------------------------------------------------
    # Change PROJECT_INFO title
    # --------------------------------------------------------

    if [[ -f "$dst_dir/PROJECT_INFO.md" ]]; then
        sed -i "1s/.*/# $dst_name/" "$dst_dir/PROJECT_INFO.md" || true
    fi

    # --------------------------------------------------------
    # Ensure board.txt always exists
    # --------------------------------------------------------

    if [[ ! -f "$dst_dir/board.txt" ]]; then
        : > "$dst_dir/board.txt"
    fi

    # --------------------------------------------------------
    # Required base folders
    # --------------------------------------------------------

    mkdir -p "$dst_dir/boards"
    mkdir -p "$dst_dir/.vscode"

    # --------------------------------------------------------
    # Board Selection
    # --------------------------------------------------------

    select_board_for_copied_project "$dst_dir"

    PROJECT_DIR="$dst_dir"

    sync_launch_json

    success "Project copied."

    # --------------------------------------------------------
    # VS Code
    # --------------------------------------------------------

    if command -v code >/dev/null 2>&1; then

        info "Opening copied project in VS Code..."
        code "$dst_dir"

    else

        warning "VS Code 'code' command not found."
        warning "Open manually:"
        warning "code \"$dst_dir\""
    fi

    # --------------------------------------------------------
    # Clean build if board exists
    # --------------------------------------------------------

    if [[ -n "$(get_board)" ]]; then

        info "Performing clean build check for copied project..."

        run_build clean

        success "Copied project built."

    else

        warning "Build skipped because no board was selected."
    fi

    echo
    echo "Project:"
    echo "  $dst_dir"
    echo
}

# ============================================================
# OPENOCD
# ============================================================

stop_old_openocd()
{
    if pgrep -x openocd >/dev/null 2>&1; then

        warning "Closing old OpenOCD process..."

        pkill -x openocd || true
        sleep 1
    fi

    if pgrep -f '[o]penocd.*interface/stlink' >/dev/null 2>&1; then

        warning "Closing old OpenOCD process using ST-Link..."

        pkill -f '[o]penocd.*interface/stlink' || true
        sleep 1
    fi
}

# ============================================================
# BUILD CHECKS
# ============================================================

check_build_output()
{
    if [[ ! -f "$PROJECT_DIR/$BUILD_DIR/zephyr/zephyr.elf" ]]; then

        error "Build output not found:"
        error "$PROJECT_DIR/$BUILD_DIR/zephyr/zephyr.elf"
        error "Perform build operation first."

        exit 1
    fi
}

check_debug_tools()
{
    if ! command -v openocd >/dev/null 2>&1; then

        warning "OpenOCD not found in system PATH."
        warning "West can use OpenOCD within the Zephyr SDK."
    fi
}

# ============================================================
# BUILD
# ============================================================

run_build()
{
    local pristine_mode="${1:-normal}"

    local board
    board="$(get_board)"

    # --------------------------------------------------------
    # Board required
    # --------------------------------------------------------

    if [[ -z "$board" ]]; then

        error "Board not selected."
        error
        error "board.txt file is empty:"
        error "$PROJECT_DIR/board.txt"
        error
        error "Example:"
        error "echo 'nucleo_f303re' > board.txt"

        exit 1
    fi

    # --------------------------------------------------------
    # west build arguments
    # --------------------------------------------------------

    local args=(
        west
        build
        --build-dir "$PROJECT_DIR/$BUILD_DIR"
    )

    if [[ "$pristine_mode" == "clean" ]]; then
        args+=(-p always)
    fi

    args+=(
        -b "$board"
        "$PROJECT_DIR"
    )

    # --------------------------------------------------------
    # Add BOARD_ROOT if custom boards exist
    # --------------------------------------------------------

    if [[ -d "$PROJECT_DIR/boards" ]] &&
       [[ -n "$(find "$PROJECT_DIR/boards" -mindepth 1 -print -quit 2>/dev/null)" ]]; then

        info "Local boards/ content found."
        info "BOARD_ROOT active."

        args+=(
            --
            "-DBOARD_ROOT=$PROJECT_DIR"
        )
    fi

    echo
    info "Board        : $board"
    info "Project        : $PROJECT_DIR"
    info "Build directory: $PROJECT_DIR/$BUILD_DIR"
    echo

    "${args[@]}"

    check_build_output

    success "Build completed."
}

# ============================================================
# FLASH
# ============================================================

run_flash()
{
    stop_old_openocd

    check_build_output
    check_debug_tools

    info "Flashing board..."

    west flash \
        --build-dir "$PROJECT_DIR/$BUILD_DIR" \
        -r openocd

    success "Flash completed."
}

# ============================================================
# DEBUG
# ============================================================

run_debug()
{
    stop_old_openocd

    check_build_output
    check_debug_tools

    info "Starting console debug..."
    info "To exit, type quit in GDB"

    west debug \
        --build-dir "$PROJECT_DIR/$BUILD_DIR" \
        -r openocd
}

# ============================================================
# DEBUG SERVER
# ============================================================

run_debugserver()
{
    stop_old_openocd

    check_build_output
    check_debug_tools

    info "Starting OpenOCD debug server."
    info "GDB: localhost:3333"
    info "Ctrl+C to stop."

    west debugserver \
        --build-dir "$PROJECT_DIR/$BUILD_DIR" \
        -r openocd
}

# ============================================================
# STATUS
# ============================================================

show_status()
{
    echo
    echo "============================================================"
    echo "Zephyr Project Status"
    echo "============================================================"
    echo

    echo "Project        : $PROJECT_DIR"
    echo "Workspace      : $ZEPHYR_WORKSPACE"
    echo "Applications   : $APPLICATIONS_DIR"
    echo "Venv           : $ZEPHYR_VENV"
    echo "Board          : $(get_board)"
    echo "Build directory: $PROJECT_DIR/$BUILD_DIR"

    echo

    if [[ -f "$PROJECT_DIR/$BUILD_DIR/zephyr/zephyr.elf" ]]; then

        success "zephyr.elf exists."

        ls -lh "$PROJECT_DIR/$BUILD_DIR/zephyr/zephyr.elf"

    else

        warning "zephyr.elf not found."
    fi

    echo

    if pgrep -a -f '[o]penocd' >/dev/null 2>&1; then

        warning "Running OpenOCD process exists:"

        pgrep -a -f '[o]penocd'

    else

        success "No running OpenOCD process."
    fi

    echo

    west --version
    cmake --version | head -n 1
    ninja --version 2>/dev/null || true

    echo
}

# ============================================================
# MAIN PROGRAM
# ============================================================

ACTION="${1:--help}"

case "$ACTION" in

    # --------------------------------------------------------
    # Help
    # --------------------------------------------------------

    -help|--help|-h)

        show_help
        ;;

    # --------------------------------------------------------
    # New Project
    # --------------------------------------------------------

    -newproject)

        if [[ $# -ne 2 ]]; then

            error "Exactly one project name must be provided for a new project."
            error
            error 'Example:'
            error 'zephyrproject -newproject "uart_test"'

            exit 1
        fi

        create_new_project "$2"
        ;;

    # --------------------------------------------------------
    # Copy Project
    # --------------------------------------------------------

    -copy)

        if [[ $# -ne 3 ]]; then

            error "Source and target project names must be provided."
            error
            error 'Example:'
            error 'zephyrproject -copy "uart_test" "uart_test_v2"'

            exit 1
        fi

        copy_existing_project "$2" "$3"
        ;;



    # --------------------------------------------------------
    # Install Completion
    # --------------------------------------------------------

    -install-completion)

        COMP_FILE="$HOME/.zephyrproject-completion.bash"
        cat <<'EOF_COMP' > "$COMP_FILE"
_zephyrproject_completion() {
    local cur prev words cword
    
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    local commands="-newproject -copy -openproject -show -build -clean -flash -clean-flash -flash-only -debug -delete -export -monitor -install-completion -help"
    
    local apps_dir="${ZEPHYR_APPLICATIONS_DIR:-${ZEPHYR_WORKSPACE:-$HOME/zephyrproject}/applications}"

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return 0
    fi

    case "$prev" in
        -openproject|-delete|-copy|-export)
            if [[ -d "$apps_dir" ]]; then
                local projects=$(find "$apps_dir" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null)
                COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
            fi
            return 0
            ;;
    esac

    return 0
}

complete -F _zephyrproject_completion zephyrproject
EOF_COMP

        if ! grep -q "source ~/.zephyrproject-completion.bash" "$HOME/.bashrc"; then
            echo -e "
# Zephyrproject bash completion
source ~/.zephyrproject-completion.bash
" >> "$HOME/.bashrc"
        fi

        success "Bash completion installed successfully!"
        warning "Please restart your terminal or run: source ~/.bashrc"
        ;;


    # --------------------------------------------------------
    # Export Project
    # --------------------------------------------------------

    -export)
        if [[ $# -ne 2 ]]; then
            error "Project name to export must be provided."
            exit 1
        fi

        PROJECT_DIR="$APPLICATIONS_DIR/$2"

        if [[ ! -d "$PROJECT_DIR" ]]; then
            error "Project not found:"
            error "$PROJECT_DIR"
            exit 1
        fi

        EXPORT_NAME="${2}_export_$(date +%Y%m%d_%H%M).tar.gz"
        info "Exporting project $2..."
        
        (cd "$APPLICATIONS_DIR" && tar -czf "$EXPORT_NAME" --exclude="$2/build" --exclude="$2/.vscode/.browse*" "$2")
        
        if [[ $? -eq 0 ]]; then
            success "Project exported successfully:"
            echo -e "  ${YELLOW}$APPLICATIONS_DIR/$EXPORT_NAME${NC}"
        else
            error "Export failed."
            exit 1
        fi
        ;;

    # --------------------------------------------------------
    # Serial Monitor
    # --------------------------------------------------------

    -monitor)
        PORT=$(ls /dev/ttyACM* /dev/ttyUSB* 2>/dev/null | head -n 1)
        if [[ -z "$PORT" ]]; then
            error "No serial port (ttyACM* or ttyUSB*) detected!"
            exit 1
        fi
        
        if ! command -v picocom &> /dev/null; then
            error "picocom is not installed."
            info "Install it using: sudo apt-get install picocom"
            exit 1
        fi

        info "Connecting to $PORT at 115200 baud using picocom..."
        info "Press Ctrl+A then Ctrl+X to exit the monitor."
        
        picocom -b 115200 "$PORT"
        ;;

    # --------------------------------------------------------
    # Delete Project
    # --------------------------------------------------------

    -delete)

        if [[ $# -ne 2 ]]; then
            error "Project name to delete must be provided."
            exit 1
        fi

        PROJECT_DIR="$APPLICATIONS_DIR/$2"

        if [[ ! -d "$PROJECT_DIR" ]]; then
            error "Project not found:"
            error "$PROJECT_DIR"
            exit 1
        fi

        warning "You are about to PERMANENTLY delete the project: $2"
        question "Are you sure? [y/N]: "
        read -r confirm
        if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
            rm -rf -- "$PROJECT_DIR"
            success "Project deleted: $2"
        else
            info "Deletion cancelled."
        fi
        ;;

    # --------------------------------------------------------
    # Open Project
    # --------------------------------------------------------

    -openproject)

        if [[ $# -ne 2 ]]; then

            error "Project name to open must be provided."
            exit 1
        fi

        PROJECT_DIR="$APPLICATIONS_DIR/$2"

        if [[ ! -d "$PROJECT_DIR" ]]; then

            error "Project not found:"
            error "$PROJECT_DIR"

            exit 1
        fi

        check_project

        if command -v code >/dev/null 2>&1; then

            info "Opening project in VS Code..."
            code "$PROJECT_DIR"

        else

            warning "VS Code 'code' command not found."
        fi

        activate_venv

        if [[ -n "$(get_board)" ]]; then

            info "Performing clean build..."
            run_build clean

        else

            warning "board.txt is empty."
            warning "Build not performed."
        fi

        ;;

    # --------------------------------------------------------
    # Show Projects
    # --------------------------------------------------------

    -show)

        if [[ ! -d "$APPLICATIONS_DIR" ]]; then

            error "Applications folder not found:"
            error "$APPLICATIONS_DIR"

            exit 1
        fi

        echo
        echo "Projects in Applications folder:"
        echo

        find "$APPLICATIONS_DIR" \
            -maxdepth 1 \
            -mindepth 1 \
            -type d \
            -printf '%f\n' |
            sort

        echo
        ;;

    # --------------------------------------------------------
    # Status
    # --------------------------------------------------------

    -status)

        check_project
        activate_venv
        show_status
        ;;

    # --------------------------------------------------------
    # Build
    # --------------------------------------------------------

    -build)

        check_project
        activate_venv

        run_build normal
        ;;

    # --------------------------------------------------------
    # Flash
    # --------------------------------------------------------

    -flash)

        check_project
        activate_venv

        run_build normal
        run_flash
        ;;

    # --------------------------------------------------------
    # Clean
    # --------------------------------------------------------

    -clean)

        check_project
        activate_venv

        run_build clean
        ;;

    # --------------------------------------------------------
    # Clean Flash
    # --------------------------------------------------------

    -clean-flash)

        check_project
        activate_venv

        run_build clean
        run_flash
        ;;

    # --------------------------------------------------------
    # Flash Only
    # --------------------------------------------------------

    -flash-only)

        check_project
        activate_venv

        run_flash
        ;;

    # --------------------------------------------------------
    # Debug
    # --------------------------------------------------------

    -debug)

        check_project
        activate_venv

        run_build normal
        run_debug
        ;;

    # --------------------------------------------------------
    # Debug Server
    # --------------------------------------------------------

    -debugserver)

        check_project
        activate_venv

        run_build normal
        run_debugserver
        ;;

    # --------------------------------------------------------
    # Menuconfig
    # --------------------------------------------------------

    -menuconfig)

        check_project
        activate_venv

        if [[ -z "$(get_board)" ]]; then

            error "Board not selected."
            error "board.txt is empty."

            exit 1
        fi

        # Configure/build if build does not exist
        if [[ ! -d "$PROJECT_DIR/$BUILD_DIR" ]]; then
            run_build normal
        fi

        info "Opening menuconfig..."

        west build \
            --build-dir "$PROJECT_DIR/$BUILD_DIR" \
            -t menuconfig

        ;;

    # --------------------------------------------------------
    # Pristine
    # --------------------------------------------------------

    -pristine)

        check_project

        if [[ -d "$PROJECT_DIR/$BUILD_DIR" ]]; then

            info "$PROJECT_DIR/$BUILD_DIR is being deleted..."

            rm -rf -- "$PROJECT_DIR/$BUILD_DIR"

            success "Build folder deleted."

        else

            warning "Build folder does not exist."
        fi

        ;;

    # --------------------------------------------------------
    # Unknown
    # --------------------------------------------------------

    *)

        error "Unknown command:"
        error "$ACTION"

        echo

        show_help

        exit 1
        ;;

esac