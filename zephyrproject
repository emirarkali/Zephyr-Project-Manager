    local DYNAMIC_GDB_PATH="\${env:HOME}/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
    if [[ -n "${ZEPHYR_SDK_INSTALL_DIR:-}" ]]; then
