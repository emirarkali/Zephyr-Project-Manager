# ============================================================
# COPY PROJECT
# ============================================================

copy_existing_project()
{
    local src_name="$1"
    local dst_name="$2"

    local src_dir="$APPLICATIONS_DIR/$src_name"
    local dst_dir="$APPLICATIONS_DIR/$dst_name"

    validate_project_name "$dst_name"

    check_command cp
    check_command sed
    check_command mkdir

    if [[ ! -d "$src_dir" ]]; then
        error "Source project not found:"
        error "$src_dir"
        exit 1
    fi

    if [[ -e "$dst_dir" ]]; then
        error "A file or folder with this name already exists:"
        error "$dst_dir"
        exit 1
    fi

    activate_venv

    info "Copying project..."
    info "Source: $src_dir"
    info "Target:  $dst_dir"

    mkdir -p "$dst_dir"

    # --------------------------------------------------------
    # Copy all project files
    # --------------------------------------------------------

    shopt -s dotglob
    cp -a "$src_dir/." "$dst_dir/"
    shopt -u dotglob

    # --------------------------------------------------------
    # Remove old build output
    # --------------------------------------------------------

    if [[ -d "$dst_dir/$BUILD_DIR" ]]; then

        info "Removing copied build folder..."

        rm -rf -- "$dst_dir/$BUILD_DIR"
    fi

    # --------------------------------------------------------
    # Change CMake project name
    # --------------------------------------------------------

    if [[ -f "$dst_dir/CMakeLists.txt" ]]; then

        update_cmake_project_name \
            "$dst_dir/CMakeLists.txt" \
            "$dst_name"

    else

        warning "CMakeLists.txt not found:"
        warning "$dst_dir/CMakeLists.txt"
    fi

    # --------------------------------------------------------
    # Change PROJECT_INFO title
    # --------------------------------------------------------

    if [[ -f "$dst_dir/PROJECT_INFO.md" ]]; then
        sed -i "1s/.*/# $dst_name/" "$dst_dir/PROJECT_INFO.md" || true
    fi

    # --------------------------------------------------------
    # Ensure board.txt always exists
    # --------------------------------------------------------

    if [[ ! -f "$dst_dir/board.txt" ]]; then
        : > "$dst_dir/board.txt"
    fi

    # --------------------------------------------------------
    # Required base folders
    # --------------------------------------------------------

    mkdir -p "$dst_dir/boards"
    mkdir -p "$dst_dir/.vscode"

    # --------------------------------------------------------
    # Board Selection
    # --------------------------------------------------------

    select_board_for_copied_project "$dst_dir"

    PROJECT_DIR="$dst_dir"

    sync_launch_json

    success "Project copied."

    # --------------------------------------------------------
    # VS Code
    # --------------------------------------------------------

    if command -v code >/dev/null 2>&1; then

        info "Opening copied project in VS Code..."
        code "$dst_dir"

    else

        warning "VS Code 'code' command not found."
        warning "Open manually:"
        warning "code \"$dst_dir\""
    fi

    # --------------------------------------------------------
    # Clean build if board exists
    # --------------------------------------------------------

    if [[ -n "$(get_board)" ]]; then

        info "Performing clean build check for copied project..."

        run_build clean

        success "Copied project built."

    else

        warning "Build skipped because no board was selected."
    fi

    echo
    echo "Project:"
    echo "  $dst_dir"
    echo
}

# ============================================================
# STM32CUBE TO ZEPHYR CONVERSION (GEMINI AI)
# ============================================================

check_internet_connection()
{
    info "Checking internet connection..."
    local online=0
    if curl -s --connect-timeout 4 -I "https://generativelanguage.googleapis.com" >/dev/null 2>&1; then
        online=1
    elif ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then
        online=1
    fi

    if [[ "$online" -eq 0 ]]; then
        error "No internet connection. Couldnt reach out to AI model for conversion."
        exit 1
    fi

    success "Internet connection verified."
}

get_gemini_api_key()
{
    local key_file="$HOME/.config/zephyrproject/gemini_api_key.txt"
    local key="${GEMINI_API_KEY:-}"

    if [[ -z "$key" && -f "$key_file" ]]; then
        key="$(tr -d '[:space:]' < "$key_file")"
    fi

    if [[ -z "$key" ]]; then
        echo >&2
        warning "Gemini API key not found in GEMINI_API_KEY environment variable" >&2
        warning "or in $key_file." >&2
        echo >&2
        info "You can get a free API key at: https://aistudio.google.com/" >&2
        question "Please enter your Gemini API key: " >&2
        read -r key
        key="${key//[[:space:]]/}"

        if [[ -z "$key" ]]; then
            error "API key cannot be empty. Conversion cancelled." >&2
            exit 1
        fi

        mkdir -p "$(dirname "$key_file")"
        printf '%s\n' "$key" > "$key_file"
        chmod 600 "$key_file"
        success "API key saved to $key_file (chmod 600)" >&2
    fi

    echo "$key"
}

select_reasoning_effort()
{
    echo >&2
    echo "------------------------------------------------------------" >&2
    echo "AI Reasoning / Effort Level" >&2
    echo "------------------------------------------------------------" >&2
    echo "  1) Low    (Fast response, minimal thinking)" >&2
    echo "  2) Medium (Balanced reasoning - Recommended)" >&2
    echo "  3) High   (Deep thinking for complex RTOS, DMA, or bus drivers)" >&2
    echo >&2

    local choice=""
    while true; do
        question "Choose level [1-3] (default 2): " >&2
        read -r choice
        choice="${choice//[[:space:]]/}"

        if [[ -z "$choice" || "$choice" == "2" ]]; then
            echo "medium"
            return 0
        elif [[ "$choice" == "1" ]]; then
            echo "low"
            return 0
        elif [[ "$choice" == "3" ]]; then
            echo "high"
            return 0
        else
            warning "Please enter 1, 2, or 3." >&2
        fi
    done
}

find_cube_project_dir()
{
    local input_path="$1"

    if [[ -z "$input_path" ]]; then
        echo >&2
        echo "------------------------------------------------------------" >&2
        echo "STM32Cube Project Location" >&2
        echo "------------------------------------------------------------" >&2
        echo "Enter folder path or project name of the STM32CubeIDE project." >&2
        question "Cube Project: " >&2
        read -r input_path
        input_path="${input_path%"${input_path##*[![:space:]]}"}"
        input_path="${input_path#"${input_path%%[![:space:]]*}"}"
    fi

    if [[ -z "$input_path" ]]; then
        error "No project path provided." >&2
        exit 1
    fi

    if [[ "$input_path" =~ ^~(/.*)?$ ]]; then
        input_path="$HOME${input_path#\~}"
    fi

    if [[ -d "$input_path" ]]; then
        (cd "$input_path" && pwd)
        return 0
    fi

    local search_name
    search_name="$(basename "$input_path")"
    info "Searching for Cube project '$search_name'..." >&2

    local found_dir=""
    found_dir="$(find "$HOME" -maxdepth 4 -type d -name "$search_name" 2>/dev/null | grep -i "cube" | head -n 1 || true)"

    if [[ -z "$found_dir" ]]; then
        found_dir="$(find "$HOME" -maxdepth 4 -type d -name "$search_name" 2>/dev/null | head -n 1 || true)"
    fi

    if [[ -n "$found_dir" && -d "$found_dir" ]]; then
        success "Found Cube project at: $found_dir" >&2
        (cd "$found_dir" && pwd)
        return 0
    fi

    error "Could not find folder: $input_path" >&2
    exit 1
}

import_cube_project()
{
    local cube_input="${1:-}"
    local target_project_name="${2:-}"

    # 1. Check internet connection
    check_internet_connection

    # 2. Activate Zephyr environment for west and python
    activate_venv

    # 3. Retrieve or prompt for Gemini API Key
    local api_key
    api_key="$(get_gemini_api_key)"

    # 4. Ask for reasoning effort
    local reasoning
    reasoning="$(select_reasoning_effort)"
    info "Reasoning effort: $reasoning"

    # 5. Locate Cube project folder
    local cube_dir
    cube_dir="$(find_cube_project_dir "$cube_input")"
    info "Source Cube Project: $cube_dir"

    # 6. Determine new project name
    if [[ -z "$target_project_name" ]]; then
        local default_name
        default_name="$(basename "$cube_dir")_zephyr"
        default_name="${default_name//[^a-zA-Z0-9_-]/_}"
        echo
        question "Enter new Zephyr project name [$default_name]: "
        read -r target_project_name
        target_project_name="${target_project_name//[[:space:]]/}"
        if [[ -z "$target_project_name" ]]; then
            target_project_name="$default_name"
        fi
    fi

    validate_project_name "$target_project_name"

    local destination="$APPLICATIONS_DIR/$target_project_name"
    if [[ -e "$destination" ]]; then
        error "A project or folder with this name already exists:"
        error "$destination"
        exit 1
    fi

    local temp_json
    temp_json="$(mktemp /tmp/zephyr_cube_conv_XXXXXX.json)"

    info "Scanning STM32Cube project files (.ioc, main.c, headers)..."
    info "Connecting to Gemini Flash model for conversion..."

    local py_bin="python3"
    if [[ -x "$ZEPHYR_VENV/bin/python3" ]]; then
        py_bin="$ZEPHYR_VENV/bin/python3"
    fi

    local py_success=0
    if "$py_bin" - "$cube_dir" "$api_key" "$reasoning" "$temp_json" << 'EOF_PYTHON'
import os
import sys
import json
import glob
import urllib.request
import urllib.error

cube_dir = sys.argv[1]
api_key = sys.argv[2]
reasoning = sys.argv[3]
out_file = sys.argv[4]

budget_map = {"low": 1024, "medium": 4096, "high": 8192}
thinking_budget = budget_map.get(reasoning, 4096)

# 1. Look for .ioc files
ioc_files = glob.glob(os.path.join(cube_dir, "*.ioc")) + glob.glob(os.path.join(cube_dir, "*", "*.ioc"))
ioc_content = ""
if ioc_files:
    try:
        with open(ioc_files[0], "r", encoding="utf-8", errors="ignore") as f:
            lines = f.readlines()
            relevant = [l for l in lines if not l.strip().startswith("#") or "Mcu." in l or "Pin" in l or "RCC." in l][:250]
            ioc_content = "".join(relevant)
    except Exception as e:
        ioc_content = f"Error reading .ioc: {e}"

# 2. Look for main.c
main_candidates = [
    os.path.join(cube_dir, "Core", "Src", "main.c"),
    os.path.join(cube_dir, "Src", "main.c"),
    os.path.join(cube_dir, "main.c")
]
main_path = None
for mc in main_candidates:
    if os.path.isfile(mc):
        main_path = mc
        break

if not main_path:
    found = glob.glob(os.path.join(cube_dir, "**", "main.c"), recursive=True)
    if found:
        main_path = found[0]

if not main_path or not os.path.isfile(main_path):
    print("Error: Could not locate main.c in STM32Cube project directory.", file=sys.stderr)
    sys.exit(1)

with open(main_path, "r", encoding="utf-8", errors="ignore") as f:
    main_c_content = f.read()

# 3. Look for other user sources
other_sources = {}
src_dir = os.path.dirname(main_path)
for src_file in glob.glob(os.path.join(src_dir, "*.c")):
    fname = os.path.basename(src_file)
    if fname not in ["main.c", "system_stm32f4xx.c", "system_stm32f3xx.c", "system_stm32f1xx.c", "stm32f4xx_hal_msp.c"]:
        try:
            with open(src_file, "r", encoding="utf-8", errors="ignore") as f:
                c = f.read()
                if len(c) < 15000:
                    other_sources[fname] = c
        except Exception:
            pass

main_h_content = ""
inc_dir = os.path.join(cube_dir, "Core", "Inc")
if os.path.isdir(inc_dir):
    for hf in glob.glob(os.path.join(inc_dir, "*.h")):
        if "stm32" not in os.path.basename(hf).lower():
            try:
                with open(hf, "r", encoding="utf-8", errors="ignore") as f:
                    main_h_content += f"\n--- {os.path.basename(hf)} ---\n" + f.read()
            except Exception:
                pass

prompt = f"""You are an elite embedded systems engineer specializing in STM32 and Zephyr RTOS.
Convert this STM32Cube (HAL / LL / FreeRTOS) project into a modern, production-ready Zephyr RTOS application.

--- HARDWARE CONFIGURATION (.ioc snippet) ---
{ioc_content if ioc_content else "No .ioc file. Deduce MCU and pinout from main.c"}

--- HEADERS ---
{main_h_content if main_h_content else "None"}

--- Core/Src/main.c ---
{main_c_content}

--- OTHER USER SOURCES ---
{json.dumps(other_sources, indent=2) if other_sources else "None"}

REQUIREMENTS:
1. Translate STM32 HAL peripheral calls (GPIO, UART, I2C, SPI, Timers, EXTI/Interrupts) into modern Zephyr driver APIs (e.g. gpio_dt_spec, gpio_pin_configure_dt, gpio_pin_set_dt, k_msleep, printk, gpio_init_callback, etc.).
2. If delays (HAL_Delay) were used, replace with non-blocking k_msleep() or k_sleep().
3. If FreeRTOS was used, translate tasks into Zephyr threads (k_thread_create or K_THREAD_DEFINE) and synchronization objects (k_sem, k_msgq, etc.).
4. Identify the closest standard Zephyr board target (e.g. nucleo_f446re, nucleo_f303re, nucleo_l476rg, etc.).
5. Produce complete, working src/main.c.
6. Produce complete prj.conf with necessary CONFIG_* options enabled.
7. Produce app.overlay if devicetree overrides are necessary (otherwise empty string).
8. Provide a concise summary of the conversion.

Respond strictly with a JSON object with these exact keys:
{{
  "suggested_board": "<string: zephyr board identifier, e.g. nucleo_f446re>",
  "main_c": "<string: full content of src/main.c>",
  "prj_conf": "<string: full content of prj.conf>",
  "app_overlay": "<string: content of app.overlay or empty string>",
  "summary": "<string: conversion summary and notes>"
}}
"""

models = ["gemini-2.5-flash", "gemini-2.0-flash", "gemini-1.5-flash"]
response_json = None
last_error = ""

for model in models:
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
    payload = {
        "contents": [{"parts": [{"text": prompt}]}],
        "generationConfig": {"responseMimeType": "application/json"}
    }
    if "2.5" in model and thinking_budget > 0:
        payload["generationConfig"]["thinkingConfig"] = {"thinkingBudget": thinking_budget}

    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=90) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            candidate = data.get("candidates", [{}])[0]
            parts = candidate.get("content", {}).get("parts", [{}])
            text = "".join([p.get("text", "") for p in parts])
            response_json = json.loads(text)
            break
    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8", errors="ignore")
        last_error = f"HTTP {e.code}: {err_msg}"
        if "thinkingConfig" in err_msg and "generationConfig" in payload and "thinkingConfig" in payload["generationConfig"]:
            del payload["generationConfig"]["thinkingConfig"]
            try:
                req2 = urllib.request.Request(
                    url,
                    data=json.dumps(payload).encode("utf-8"),
                    headers={"Content-Type": "application/json"}
                )
                with urllib.request.urlopen(req2, timeout=90) as resp2:
                    data = json.loads(resp2.read().decode("utf-8"))
                    candidate = data.get("candidates", [{}])[0]
                    parts = candidate.get("content", {}).get("parts", [{}])
                    text = "".join([p.get("text", "") for p in parts])
                    response_json = json.loads(text)
                    break
            except Exception as e2:
                last_error = str(e2)
        continue
    except Exception as e:
        last_error = str(e)
        continue

if not response_json:
    print(f"Error calling Gemini API: {last_error}", file=sys.stderr)
    sys.exit(1)

with open(out_file, "w", encoding="utf-8") as f:
    json.dump(response_json, f, indent=2)

print("SUCCESS")
EOF_PYTHON
    then
