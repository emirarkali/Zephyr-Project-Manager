# ------------------------------------------------------------
# ------------------------------------------------------------
# App Directory Resolution
# ------------------------------------------------------------

resolve_app_dir()
{
    local app_arg="${1:-}"

    if [[ -n "$app_arg" ]]; then
        if [[ -d "$PROJECT_DIR/apps/$app_arg" ]]; then
            APP_DIR="$PROJECT_DIR/apps/$app_arg"
        elif [[ -d "$PROJECT_DIR/$app_arg" ]]; then
            APP_DIR="$PROJECT_DIR/$app_arg"
        else
            error "App not found: $app_arg"
            exit 1
        fi
    else
        if [[ -d "$PROJECT_DIR/apps" ]] && [[ -n "$(ls -A "$PROJECT_DIR/apps" 2>/dev/null)" ]]; then
            local apps=()
            for app in "$PROJECT_DIR/apps/"*; do
                if [[ -d "$app" && -f "$app/CMakeLists.txt" ]]; then
                    apps+=("$(basename "$app")")
                fi
            done

            if [[ ${#apps[@]} -eq 0 ]]; then
                APP_DIR="$PROJECT_DIR"
            elif [[ ${#apps[@]} -eq 1 ]]; then
                APP_DIR="$PROJECT_DIR/apps/${apps[0]}"
                info "Auto-selected app: ${apps[0]}"
            else
                if [[ ! -t 0 ]]; then
                    error "Multiple apps found but not interactive. Specify app name."
                    exit 1
                fi

                echo
                echo "This project contains multiple apps. Please select one:"
                for idx in "${!apps[@]}"; do
                    echo "  $((idx+1))) ${apps[$idx]}"
                done
                echo "  q) Quit"
                echo

                while true; do
                    question "Select app [1-${#apps[@]}]: "
                    read -r app_choice

                    if [[ "$app_choice" == "q" || "$app_choice" == "Q" ]]; then
                        error "Operation cancelled."
                        exit 1
                    fi

                    if [[ "$app_choice" =~ ^[0-9]+$ ]] && (( app_choice >= 1 && app_choice <= ${#apps[@]} )); then
                        APP_DIR="$PROJECT_DIR/apps/${apps[$((app_choice-1))]}"
                        break
                    else
                        warning "Invalid selection."
                    fi
                done
            fi
        else
            APP_DIR="$PROJECT_DIR"
        fi
    fi
}

# General checks
# ------------------------------------------------------------

check_command()
{
    local command_name="$1"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        error "Required command not found: $command_name"
        exit 1
    fi
}


sync_launch_json()
{
    if [[ -f "$PROJECT_DIR/.vscode/launch.json" ]]; then
        local b="$(get_board)"
        if [[ -n "$b" ]]; then
            sed -i "s/"device": ".*"/"device": "$b"/" "$PROJECT_DIR/.vscode/launch.json"
        fi
    fi
}

check_app()
{
    if [[ ! -f "$APP_DIR/CMakeLists.txt" ]]; then
        error "CMakeLists.txt not found in this folder:"
        error "$APP_DIR"
        error "Run the command in the Zephyr application root folder."
        exit 1
    fi

    if [[ ! -d "$APP_DIR/src" ]]; then
        error "src folder not found:"
        error "$APP_DIR/src"
        exit 1
    fi

    if [[ ! -f "$APP_DIR/src/main.c" ]]; then
        warning "src/main.c not found."
    fi

    if [[ ! -f "$APP_DIR/prj.conf" ]]; then
        warning "prj.conf not found."
    fi

    if [[ ! -f "$APP_DIR/board.txt" ]]; then
        warning "board.txt not found."
    fi

    sync_launch_json
}

# ------------------------------------------------------------
# Zephyr virtual environment
# ------------------------------------------------------------

activate_venv()
{
    if [[ ! -f "$ZEPHYR_VENV/bin/activate" ]]; then
        error "Zephyr virtual environment not found:"
        error "$ZEPHYR_VENV/bin/activate"
        exit 1
    fi

    # shellcheck disable=SC1090
    source "$ZEPHYR_VENV/bin/activate"

    if ! command -v west >/dev/null 2>&1; then
        error "Virtual environment activated but west not found."
        exit 1
    fi
}

# ============================================================
# BOARD MANAGEMENT
# ============================================================

# ------------------------------------------------------------
# Read board.txt
# ------------------------------------------------------------

get_board()
{
    if [[ -f "$APP_DIR/board.txt" ]]; then
        tr -d '[:space:]' < "$APP_DIR/board.txt"
    else
        echo ""
    fi
}

# ------------------------------------------------------------
# Write board to board.txt
# ------------------------------------------------------------

write_board()
{
    local project="$1"
    local board="$2"

    printf '%s\n' "$board" > "$project/board.txt"
}

# ------------------------------------------------------------
# Is board known by Zephyr?
# ------------------------------------------------------------

board_exists()
{
    local board="$1"

    [[ -n "$board" ]] || return 1

    (cd "$ZEPHYR_WORKSPACE" && west boards -f "{name}" 2>/dev/null) |
        sed '/^[[:space:]]*$/d' |
        grep -Fx -- "$board" >/dev/null
}

# ------------------------------------------------------------
# Show similar board names
# ------------------------------------------------------------

show_similar_boards()
{
    local board="$1"

    echo
    info "Similar Zephyr board names:"

    (cd "$ZEPHYR_WORKSPACE" && west boards -f "{name}" 2>/dev/null) |
        grep -i -- "$board" |
        head -n 10 || true

    echo
}

# ------------------------------------------------------------
# Select board for new project
# ------------------------------------------------------------

select_board_for_new_project()
{
    local destination="$1"
    local board=""

    echo
    echo "------------------------------------------------------------"
    echo "Board Selection"
    echo "------------------------------------------------------------"
    echo
    echo "Enter Zephyr board name."
    echo
    echo "Example:"
    echo "  nucleo_f303re"
    echo "  nucleo_f303k8"
    echo
    echo "To configure the board manually later:"
    echo "  q"
    echo

    while true; do

        question "Board: "
        read -r board

        board="${board//[[:space:]]/}"

        if [[ "$board" == "q" || "$board" == "Q" ]]; then

            : > "$destination/board.txt"

            warning "Board selection skipped."
            warning "board.txt left empty."

            return 0
        fi

        if [[ -z "$board" ]]; then
            warning "Board name cannot be empty."
            warning "Type q to skip and configure manually."
            continue
        fi

        info "Checking board in Zephyr list..."

        if board_exists "$board"; then

            write_board "$destination" "$board"

            success "Board found: $board"
            return 0

        else

            error "This board was not found in Zephyr:"
            error "$board"

            show_similar_boards "$board"

            warning "Enter board name again or type q for manual configuration."
        fi
    done
}

# ------------------------------------------------------------
# Select board for copied project
# ------------------------------------------------------------

select_board_for_copied_project()
{
    local destination="$1"
    local old_board=""
    local board=""

    if [[ -f "$destination/board.txt" ]]; then
        old_board="$(tr -d '[:space:]' < "$destination/board.txt")"
    fi

    echo
    echo "------------------------------------------------------------"
    echo "Board Selection"
    echo "------------------------------------------------------------"
    echo

    if [[ -n "$old_board" ]]; then
        echo "Board in source project:"
        echo
        echo "  $old_board"
        echo
    else
        echo "No board selected in source project."
        echo
    fi

    echo "Options:"
    echo
    echo "  k            Keep the old board"
    echo "  q            Leave board.txt empty"
    echo "  <board name>  Select a new Zephyr board"
    echo

    while true; do

        question "Board Selection: "
        read -r board

        board="${board//[[:space:]]/}"

        # ----------------------------------------------------
        # Keep old board
        # ----------------------------------------------------

        if [[ "$board" == "k" || "$board" == "K" ]]; then

            if [[ -z "$old_board" ]]; then
                warning "No board to keep in source project."
                continue
            fi

            success "Keeping board: $old_board"
            return 0
        fi

        # ----------------------------------------------------
        # Leave board empty
        # ----------------------------------------------------

        if [[ "$board" == "q" || "$board" == "Q" ]]; then

            : > "$destination/board.txt"

            warning "board.txt left empty."
            return 0
        fi

        # ----------------------------------------------------
        # Empty input
        # ----------------------------------------------------

        if [[ -z "$board" ]]; then
            warning "Enter a board name, k or q."
            continue
        fi

        # ----------------------------------------------------
        # Verify new Zephyr board
        # ----------------------------------------------------

        info "Checking board in Zephyr list..."

        if board_exists "$board"; then

            write_board "$destination" "$board"

            success "New board selected: $board"
            return 0

        else

            error "This board was not found in Zephyr:"
            error "$board"

            show_similar_boards "$board"

            warning "Try again."
        fi
    done
}

# ============================================================
# PROJECT NAME
# ============================================================

validate_project_name()
{
    local LC_ALL=C
    local project_name="$1"

    if [[ -z "$project_name" ]]; then
        error "Project name not specified."
        exit 1
    fi

    if [[ "$project_name" == "." || "$project_name" == ".." ]]; then
        error "Invalid project name: $project_name"
        exit 1
    fi

    if [[ "$project_name" == */* ]]; then
        error "Project name cannot contain folder paths."
        error "Enter only the project name."
        exit 1
    fi

    if [[ ! "$project_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
        error "Invalid project name:"
        error "$project_name"
        error "Only letters, numbers, underscores and hyphens are allowed."
        exit 1
    fi
}

# ------------------------------------------------------------
# Change CMake project(...) name
# ------------------------------------------------------------

update_cmake_project_name()
{
    local cmake_file="$1"
    local project_name="$2"
    local cmake_project_name

    cmake_project_name="${project_name//-/_}"

    if grep -Eq '^[[:space:]]*project\(' "$cmake_file"; then

        sed -i -E \
            "s/^[[:space:]]*project\([^)]*\)/project($cmake_project_name)/" \
            "$cmake_file"

    else
        warning "project(...) not found in CMakeLists.txt."
    fi
}


# ============================================================
# APP CREATION LOGIC
# ============================================================

scaffold_app()
{
    local dest_dir="$1"
    local app_name="$2"
    local sample_path="${3:-}"
    
    local cmake_app_name="${app_name//-/_}"
    local selected_sample=""
    
    if [[ "$sample_path" == "-sample" ]]; then
        echo
        echo "------------------------------------------------------------"
        echo "Sample Selection for App: $app_name"
        echo "------------------------------------------------------------"
        echo
        echo "Select a sample project to copy:"
        echo "  1) hello_world"
        echo "  2) blinky"
        echo "  3) button"
        echo "  4) fade_led"
        echo "  5) philosophers"
        echo "  q) Quit / No sample (minimal app)"
        echo
        while true; do
            question "Select [1-5 or q]: "
            read -r sample_choice
            case "$sample_choice" in
                1) selected_sample="hello_world"; break ;;
                2) selected_sample="basic/blinky"; break ;;
                3) selected_sample="basic/button"; break ;;
                4) selected_sample="basic/fade_led"; break ;;
                5) selected_sample="philosophers"; break ;;
                q|Q) selected_sample=""; break ;;
                *) warning "Invalid choice. Enter 1-5 or q." ;;
            esac
        done
    elif [[ -n "$sample_path" ]]; then
        selected_sample="$sample_path"
    fi

    if [[ -n "$selected_sample" ]]; then
        local sample_dir="$ZEPHYR_WORKSPACE/zephyr/samples/$selected_sample"
        if [[ ! -d "$sample_dir" ]]; then
            error "Sample folder not found: $sample_dir"
            exit 1
        fi
        
        info "Copying sample: $selected_sample to $dest_dir"
        mkdir -p "$dest_dir"
        cp -a "$sample_dir/." "$dest_dir/"
        
        mkdir -p "$dest_dir/boards"
        rm -rf -- "$dest_dir/build" 2>/dev/null || true
        
        update_cmake_project_name "$dest_dir/CMakeLists.txt" "$app_name"
        : > "$dest_dir/board.txt"
    else
        mkdir -p "$dest_dir/src"
        mkdir -p "$dest_dir/boards"

        cat > "$dest_dir/CMakeLists.txt" <<EOF_CMAKE
cmake_minimum_required(VERSION 3.20.0)
find_package(Zephyr REQUIRED HINTS \$ENV{ZEPHYR_BASE})
project($cmake_app_name)
target_sources(app PRIVATE src/main.c)
EOF_CMAKE

        cat > "$dest_dir/prj.conf" <<'EOF_CONF'
# Zephyr Project Configuration
CONFIG_PRINTK=y
CONFIG_ASSERT=y
CONFIG_LOG=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_MAIN_STACK_SIZE=2048
EOF_CONF

        : > "$dest_dir/board.txt"

        cat > "$dest_dir/src/main.c" <<'EOF_MAIN'
#include <zephyr/kernel.h>
#include <zephyr/sys/printk.h>

int main(void)
{
    printk("Zephyr application started.\n");
    while (1) {
        k_sleep(K_SECONDS(1));
    }
    return 0;
}
EOF_MAIN
    fi

    if [[ ! -f "$dest_dir/app.overlay" ]]; then
        cat > "$dest_dir/app.overlay" <<'EOF_OV'
/*
 * Zephyr Devicetree Overlay
 */
EOF_OV
    fi
}

# ============================================================
# NEW PROJECT
# ============================================================


create_new_project()
{
    local project_name="$1"
    local sample_path="$2"
    
    if [[ "$project_name" == "-sample" ]]; then
        sample_path="-sample"
        project_name=""
    fi
    
    echo
    echo "============================================================"
    echo "Create New Multi-App Zephyr Project"
    echo "============================================================"
    echo
    
    if [[ -z "$project_name" ]]; then
        while true; do
            question "Enter Project (Workspace) Name: "
            read -r project_name
            if [[ -n "$project_name" ]]; then
                break
            else
                warning "Project name cannot be empty."
            fi
        done
    fi

    validate_project_name "$project_name"
    local destination="$APPLICATIONS_DIR/$project_name"

    check_command mkdir
    check_command cat

    if [[ ! -d "$APPLICATIONS_DIR" ]]; then
        error "Applications folder not found: $APPLICATIONS_DIR"
        exit 1
    fi

    if [[ -e "$destination" ]]; then
        error "A file or folder with this name already exists: $destination"
        exit 1
    fi

    activate_venv

    info "Creating new multi-app Zephyr project..."
    info "Target: $destination"

    mkdir -p "$destination"
    mkdir -p "$destination/.vscode"
    
    cat > "$destination/.gitignore" <<'EOF_GIT'
build/
.vscode/*.log
*.swp
*~
EOF_GIT

    cat > "$destination/.vscode/tasks.json" <<'EOF_TASKS'
