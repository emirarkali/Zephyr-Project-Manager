# ------------------------------------------------------------
# ADD APP
# ------------------------------------------------------------

add_app_to_project()
{
    local app_name="$1"
    local sample_path="${2:-}"
    
    validate_project_name "$app_name"
    
    if [[ ! -d "$PROJECT_DIR" ]]; then
        error "Must run inside a project directory."
        exit 1
    fi
    
    mkdir -p "$PROJECT_DIR/apps"
    local app_dest="$PROJECT_DIR/apps/$app_name"
    
    if [[ -e "$app_dest" ]]; then
        error "App already exists: $app_dest"
        exit 1
    fi
    
    activate_venv
    
    info "Creating new app in workspace: $app_name"
    scaffold_app "$app_dest" "$app_name" "$sample_path"
    
    select_board_for_new_project "$app_dest"
    
    success "App '$app_name' created successfully."
    info "Run 'zephyrproject -build $app_name' to build it."
}

# ============================================================
# COPY PROJECT
# ============================================================

copy_existing_project()
{
    local src_name="$1"
    local dst_name="$2"

    local src_dir="$APPLICATIONS_DIR/$src_name"
    local dst_dir="$APPLICATIONS_DIR/$dst_name"

    validate_project_name "$dst_name"

    check_command cp
    check_command sed
    check_command mkdir

    if [[ ! -d "$src_dir" ]]; then
        error "Source project not found:"
        error "$src_dir"
        exit 1
    fi

    if [[ -e "$dst_dir" ]]; then
        error "A file or folder with this name already exists:"
        error "$dst_dir"
        exit 1
    fi

    activate_venv

    info "Copying project..."
    info "Source: $src_dir"
    info "Target:  $dst_dir"

    mkdir -p "$dst_dir"

    # --------------------------------------------------------
    # Copy all project files
    # --------------------------------------------------------

    shopt -s dotglob
    cp -a "$src_dir/." "$dst_dir/"
    shopt -u dotglob

    # --------------------------------------------------------
    # Remove old build output
    # --------------------------------------------------------

    if [[ -d "$dst_dir/$BUILD_DIR" ]]; then

        info "Removing copied build folder..."

        rm -rf -- "$dst_dir/$BUILD_DIR"
    fi

    # --------------------------------------------------------
    # Change CMake project name
    # --------------------------------------------------------

    if [[ -f "$dst_dir/CMakeLists.txt" ]]; then

        update_cmake_project_name \
            "$dst_dir/CMakeLists.txt" \
            "$dst_name"

    else

        warning "CMakeLists.txt not found:"
        warning "$dst_dir/CMakeLists.txt"
    fi

    # --------------------------------------------------------
    # Change PROJECT_INFO title
    # --------------------------------------------------------

    if [[ -f "$dst_dir/PROJECT_INFO.md" ]]; then
        sed -i "1s/.*/# $dst_name/" "$dst_dir/PROJECT_INFO.md" || true
    fi

    # --------------------------------------------------------
    # Ensure board.txt always exists
    # --------------------------------------------------------

    if [[ ! -f "$dst_dir/board.txt" ]]; then
        : > "$dst_dir/board.txt"
    fi

    # --------------------------------------------------------
    # Required base folders
    # --------------------------------------------------------

    mkdir -p "$dst_dir/boards"
    mkdir -p "$dst_dir/.vscode"

    # --------------------------------------------------------
    # Board Selection
    # --------------------------------------------------------

    select_board_for_copied_project "$dst_dir"

    PROJECT_DIR="$dst_dir"

    sync_launch_json

    success "Project copied."

    # --------------------------------------------------------
    # VS Code
    # --------------------------------------------------------

    if command -v code >/dev/null 2>&1; then

        info "Opening copied project in VS Code..."
        code "$dst_dir"

    else

        warning "VS Code 'code' command not found."
        warning "Open manually:"
        warning "code \"$dst_dir\""
    fi

    # --------------------------------------------------------
    # Clean build if board exists
    # --------------------------------------------------------

    if [[ -n "$(get_board)" ]]; then

        info "Performing clean build check for copied project..."

        run_build clean

        success "Copied project built."

    else

        warning "Build skipped because no board was selected."
    fi

    echo
    echo "Project:"
    echo "  $dst_dir"
    echo
}

# ============================================================
# OPENOCD
# ============================================================

stop_old_openocd()
{
    if pgrep -x openocd >/dev/null 2>&1; then

        warning "Closing old OpenOCD process..."

        pkill -x openocd || true
        sleep 1
    fi

    if pgrep -f '[o]penocd.*interface/stlink' >/dev/null 2>&1; then

        warning "Closing old OpenOCD process using ST-Link..."

        pkill -f '[o]penocd.*interface/stlink' || true
        sleep 1
    fi
}

# ============================================================
# BUILD CHECKS
# ============================================================

check_build_output()
{
    if [[ ! -f "$APP_DIR/$BUILD_DIR/zephyr/zephyr.elf" ]]; then

        error "Build output not found:"
        error "$APP_DIR/$BUILD_DIR/zephyr/zephyr.elf"
        error "Perform build operation first."

        exit 1
    fi
}

check_debug_tools()
{
    if ! command -v openocd >/dev/null 2>&1; then

        warning "OpenOCD not found in system PATH."
        warning "West can use OpenOCD within the Zephyr SDK."
    fi
}

# ============================================================
# BUILD
# ============================================================

run_build()
{
    local pristine_mode="${1:-normal}"

    local board
    board="$(get_board)"

    # --------------------------------------------------------
    # Board required
    # --------------------------------------------------------

    if [[ -z "$board" ]]; then

        error "Board not selected."
        error
        error "board.txt file is empty:"
        error "$APP_DIR/board.txt"
        error
        error "Example:"
        error "echo 'nucleo_f303re' > board.txt"

        exit 1
    fi

    # --------------------------------------------------------
    # west build arguments
    # --------------------------------------------------------

    local args=(
        west
        build
        --build-dir "$APP_DIR/$BUILD_DIR"
    )

    if [[ "$pristine_mode" == "clean" ]]; then
        args+=(-p always)
    fi

    args+=(
        -b "$board"
        "$APP_DIR"
    )

    # --------------------------------------------------------
    # Add BOARD_ROOT if custom boards exist
    # --------------------------------------------------------

    if [[ -d "$APP_DIR/boards" ]] &&
       [[ -n "$(find "$APP_DIR/boards" -mindepth 1 -print -quit 2>/dev/null)" ]]; then

        info "Local boards/ content found in app."
        info "BOARD_ROOT active."

        args+=(
            --
            "-DBOARD_ROOT=$APP_DIR"
        )
    elif [[ -d "$PROJECT_DIR/boards" ]] &&
       [[ -n "$(find "$PROJECT_DIR/boards" -mindepth 1 -print -quit 2>/dev/null)" ]]; then

        info "Local boards/ content found in project."
        info "BOARD_ROOT active."

        args+=(
            --
            "-DBOARD_ROOT=$PROJECT_DIR"
        )
    fi

    echo
    info "Board        : $board"
    info "Project        : $PROJECT_DIR"
    info "App Directory  : $APP_DIR"
    info "Build directory: $APP_DIR/$BUILD_DIR"
    echo

    "${args[@]}"

    check_build_output

    success "Build completed."
}

# ============================================================
# FLASH
# ============================================================

run_flash()
{
    stop_old_openocd

    check_build_output
    check_debug_tools

    info "Flashing board..."

    if west flash --build-dir "$APP_DIR/$BUILD_DIR" -r openocd; then
        success "Flash completed."
    else
        warning "openocd failed. Trying pyocd instead..."
        
        if ! command -v pyocd >/dev/null 2>&1; then
            question "pyocd is not installed. Do you want to install it with pip? [y/N]: "
            read -r confirm
            if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
                info "Installing pyocd..."
                pip install pyocd
            else
                info "pyocd installation cancelled."
                info "Recommendation: You can flash manually using other supported runners like stm32cubeprogrammer."
                info "Example: west flash -r stm32cubeprogrammer"
                exit 1
            fi
        fi

        info "Flashing with pyocd..."
        if west flash --build-dir "$APP_DIR/$BUILD_DIR" -r pyocd; then
            success "Flash completed with pyocd."
        else
            error "Flash with pyocd also failed."
            info "Recommendation: Try other runners like stm32cubeprogrammer or jlink."
            exit 1
        fi
    fi
}

# ============================================================
# DEBUG
# ============================================================

run_debug()
{
    stop_old_openocd

    check_build_output
    check_debug_tools

    info "Starting console debug..."
    info "To exit, type quit in GDB"

    west debug \
        --build-dir "$APP_DIR/$BUILD_DIR" \
        -r openocd
}

# ============================================================
# DEBUG SERVER
# ============================================================

run_debugserver()
{
    stop_old_openocd

    check_build_output
    check_debug_tools

    info "Starting OpenOCD debug server."
    info "GDB: localhost:3333"
    info "Ctrl+C to stop."

    west debugserver \
        --build-dir "$APP_DIR/$BUILD_DIR" \
        -r openocd
}

# ============================================================
# STATUS
# ============================================================

show_status()
{
    echo
    echo "============================================================"
    echo "Zephyr Project Status"
    echo "============================================================"
    echo

    echo "Project        : $PROJECT_DIR"
    echo "App Directory  : $APP_DIR"
    echo "Workspace      : $ZEPHYR_WORKSPACE"
    echo "Applications   : $APPLICATIONS_DIR"
    echo "Venv           : $ZEPHYR_VENV"
    echo "Board          : $(get_board)"
    echo "Build directory: $APP_DIR/$BUILD_DIR"

    echo

    if [[ -f "$PROJECT_DIR/$BUILD_DIR/zephyr/zephyr.elf" ]]; then

        success "zephyr.elf exists."

        ls -lh "$PROJECT_DIR/$BUILD_DIR/zephyr/zephyr.elf"

    else

        warning "zephyr.elf not found."
    fi

    echo

    if pgrep -a -f '[o]penocd' >/dev/null 2>&1; then

        warning "Running OpenOCD process exists:"

        pgrep -a -f '[o]penocd'

    else

        success "No running OpenOCD process."
    fi

    echo

    west --version
    cmake --version | head -n 1
    ninja --version 2>/dev/null || true

    echo
}

# ============================================================
# MAIN PROGRAM
# ============================================================

ACTION="${1:--help}"

if [[ "$ACTION" != "-help" && "$ACTION" != "--help" && "$ACTION" != "-h" && "$ACTION" != "-install-completion" ]]; then
    if [[ ! -d "$ZEPHYR_WORKSPACE" ]]; then
        error "Zephyr workspace directory not found: $ZEPHYR_WORKSPACE"
        info "To fix this, set the ZEPHYR_WORKSPACE environment variable in your ~/.bashrc"
        info "Example: export ZEPHYR_WORKSPACE=/path/to/your/zephyrproject"
        exit 1
    fi
fi

case "$ACTION" in

    # --------------------------------------------------------
    # Help
    # --------------------------------------------------------

    -help|--help|-h)

        show_help
        ;;

    # --------------------------------------------------------
    # New Project
    # --------------------------------------------------------


    -addapp)
        if [[ $# -lt 2 || $# -gt 3 ]]; then
            error "Invalid arguments for add app."
            error 'Example: zephyrproject -addapp "traction" [-sample]'
            exit 1
        fi
        add_app_to_project "$2" "${3:-}"
        ;;

    -newproject)
        if [[ $# -gt 3 ]]; then
            error "Invalid arguments for new project."
            error 'Example: zephyrproject -newproject ["project_name"] [-sample]'
            exit 1
        fi
        create_new_project "${2:-}" "${3:-}"
        ;;

    # --------------------------------------------------------
    # Copy Project
    # --------------------------------------------------------

    -copy)

        if [[ $# -ne 3 ]]; then

            error "Source and target project names must be provided."
            error
            error 'Example:'
            error 'zephyrproject -copy "uart_test" "uart_test_v2"'

            exit 1
        fi

        copy_existing_project "$2" "$3"
        ;;



    # --------------------------------------------------------
    # Install Completion
    # --------------------------------------------------------

    -install-completion)

        COMP_FILE="$HOME/.zephyrproject-completion.bash"
        cat <<'EOF_COMP' > "$COMP_FILE"
_zephyrproject_completion() {
    local cur prev words cword
    
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    local commands="-newproject -copy -openproject -show -build -clean -flash -clean-flash -flash-only -debug -delete -export -monitor -install-completion -help"
    
    local apps_dir="${ZEPHYR_APPLICATIONS_DIR:-${ZEPHYR_WORKSPACE:-$HOME/zephyrproject}/applications}"

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return 0
    fi

    case "$prev" in
        -openproject|-delete|-copy|-export)
            if [[ -d "$apps_dir" ]]; then
                local projects=$(find "$apps_dir" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null)
                COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
            fi
            return 0
            ;;
    esac

    return 0
}

complete -F _zephyrproject_completion zephyrproject
EOF_COMP

        if ! grep -q "source ~/.zephyrproject-completion.bash" "$HOME/.bashrc"; then
            echo -e "
# Zephyrproject bash completion
source ~/.zephyrproject-completion.bash
" >> "$HOME/.bashrc"
        fi

        success "Bash completion installed successfully!"
        warning "Please restart your terminal or run: source ~/.bashrc"
        ;;


    # --------------------------------------------------------
    # Export Project
    # --------------------------------------------------------

    -export)
        if [[ $# -ne 2 ]]; then
            error "Project name to export must be provided."
            exit 1
        fi

        PROJECT_DIR="$APPLICATIONS_DIR/$2"

        if [[ ! -d "$PROJECT_DIR" ]]; then
            error "Project not found:"
            error "$PROJECT_DIR"
            exit 1
        fi

        EXPORT_NAME="${2}_export_$(date +%Y%m%d_%H%M).tar.gz"
        info "Exporting project $2..."
        
        (cd "$APPLICATIONS_DIR" && tar -czf "$EXPORT_NAME" --exclude="$2/build" --exclude="$2/.vscode/.browse*" "$2")
        
        if [[ $? -eq 0 ]]; then
            success "Project exported successfully:"
            echo -e "  ${YELLOW}$APPLICATIONS_DIR/$EXPORT_NAME${NC}"
        else
            error "Export failed."
            exit 1
        fi
        ;;

    # --------------------------------------------------------
    # Serial Monitor
    # --------------------------------------------------------

    -monitor)
        PORT=$(ls /dev/ttyACM* /dev/ttyUSB* 2>/dev/null | head -n 1)
        if [[ -z "$PORT" ]]; then
            error "No serial port (ttyACM* or ttyUSB*) detected!"
            exit 1
        fi
        
        if ! command -v picocom &> /dev/null; then
            error "picocom is not installed."
            info "Install it using: sudo apt-get install picocom"
            exit 1
        fi

        info "Connecting to $PORT at 115200 baud using picocom..."
        info "Press Ctrl+A then Ctrl+X to exit the monitor."
        
        picocom -b 115200 "$PORT"
        ;;

    # --------------------------------------------------------
    # Delete Project
    # --------------------------------------------------------

    -delete)

        if [[ $# -ne 2 ]]; then
            error "Project name to delete must be provided."
            exit 1
        fi

        PROJECT_DIR="$APPLICATIONS_DIR/$2"

        if [[ ! -d "$PROJECT_DIR" ]]; then
            error "Project not found:"
            error "$PROJECT_DIR"
            exit 1
        fi

        warning "You are about to PERMANENTLY delete the project: $2"
        question "Are you sure? [y/N]: "
        read -r confirm
        if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
            rm -rf -- "$PROJECT_DIR"
            success "Project deleted: $2"
        else
            info "Deletion cancelled."
        fi
        ;;

    # --------------------------------------------------------
    # Open Project
    # --------------------------------------------------------

    -openproject)

        if [[ $# -ne 2 ]]; then

            error "Project name to open must be provided."
            exit 1
        fi

        PROJECT_DIR="$APPLICATIONS_DIR/$2"

        if [[ ! -d "$PROJECT_DIR" ]]; then

            error "Project not found:"
            error "$PROJECT_DIR"

            exit 1
        fi

        resolve_app_dir ""
        check_app

        if command -v code >/dev/null 2>&1; then

            info "Opening project in VS Code..."
            code "$PROJECT_DIR"

        else

            warning "VS Code 'code' command not found."
        fi

        activate_venv

        if [[ -n "$(get_board)" ]]; then

            info "Performing clean build..."
            run_build clean

        else

            warning "board.txt is empty."
            warning "Build not performed."
        fi

        ;;

    # --------------------------------------------------------
    # Show Projects
    # --------------------------------------------------------

    -show)

        if [[ ! -d "$APPLICATIONS_DIR" ]]; then

            error "Applications folder not found:"
            error "$APPLICATIONS_DIR"

            exit 1
        fi

        echo
        echo "Projects in Applications folder:"
        echo

        find "$APPLICATIONS_DIR" \
            -maxdepth 1 \
            -mindepth 1 \
            -type d \
            -printf '%f\n' |
            sort

        echo
        ;;

    # --------------------------------------------------------
    # Status
    # --------------------------------------------------------

    -status)

        resolve_app_dir "${2:-}"
        check_app
        activate_venv
        show_status
        ;;

    # --------------------------------------------------------
    # Build
    # --------------------------------------------------------

    -build)

        resolve_app_dir "${2:-}"
        check_app
        activate_venv

        run_build normal
        ;;

    # --------------------------------------------------------
    # Flash
    # --------------------------------------------------------

    -flash)

        resolve_app_dir "${2:-}"
        check_app
        activate_venv

        run_build normal
        run_flash
        ;;

    # --------------------------------------------------------
    # Clean
    # --------------------------------------------------------

    -clean)

        resolve_app_dir "${2:-}"
        check_app
        activate_venv

        run_build clean
        ;;

    # --------------------------------------------------------
    # Clean Flash
    # --------------------------------------------------------

    -clean-flash)

        resolve_app_dir "${2:-}"
        check_app
        activate_venv

        run_build clean
        run_flash
        ;;

    # --------------------------------------------------------
    # Flash Only
    # --------------------------------------------------------

    -flash-only)

        resolve_app_dir "${2:-}"
        check_app
        activate_venv

        run_flash
        ;;

    # --------------------------------------------------------
    # Debug
    # --------------------------------------------------------

    -debug)

        resolve_app_dir "${2:-}"
        check_app
        activate_venv

        run_build normal
        run_debug
        ;;

    # --------------------------------------------------------
    # Debug Server
    # --------------------------------------------------------

    -debugserver)

        resolve_app_dir "${2:-}"
        check_app
        activate_venv

        run_build normal
        run_debugserver
        ;;

    # --------------------------------------------------------
    # Menuconfig
    # --------------------------------------------------------

    -menuconfig)

        resolve_app_dir "${2:-}"
        check_app
        activate_venv

        if [[ -z "$(get_board)" ]]; then

            error "Board not selected."
            error "board.txt is empty."

            exit 1
        fi

        # Configure/build if build does not exist
        if [[ ! -d "$APP_DIR/$BUILD_DIR" ]]; then
            run_build normal
        fi

        info "Opening menuconfig..."

        west build \
            --build-dir "$APP_DIR/$BUILD_DIR" \
            -t menuconfig

        ;;

    # --------------------------------------------------------
    # Pristine
    # --------------------------------------------------------

    -pristine)

        resolve_app_dir "${2:-}"
        check_app

        if [[ -d "$APP_DIR/$BUILD_DIR" ]]; then

            info "$PROJECT_DIR/$BUILD_DIR is being deleted..."

            rm -rf -- "$APP_DIR/$BUILD_DIR"

            success "Build folder deleted."

        else

            warning "Build folder does not exist."
        fi

        ;;

    # --------------------------------------------------------
    # Unknown
    # --------------------------------------------------------

    *)

        error "Unknown command:"
        error "$ACTION"

        echo

        show_help

        exit 1
        ;;

esac
