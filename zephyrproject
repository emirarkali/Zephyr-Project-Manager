    -newproject)

        if [[ $# -ne 2 ]]; then

            error "Exactly one project name must be provided for a new project."
            error
            error 'Example:'
            error 'zephyrproject -newproject "uart_test"'

            exit 1
        fi

        create_new_project "$2"
        ;;

    # --------------------------------------------------------
    # Copy Project
    # --------------------------------------------------------

    -copy)

        if [[ $# -ne 3 ]]; then

            error "Source and target project names must be provided."
            error
            error 'Example:'
            error 'zephyrproject -copy "uart_test" "uart_test_v2"'

            exit 1
        fi

        copy_existing_project "$2" "$3"
        ;;

    # --------------------------------------------------------
    # Import STM32Cube Project
    # --------------------------------------------------------

    -import-cube|-cube|--import-cube)

        import_cube_project "${2:-}" "${3:-}"
        ;;

    # --------------------------------------------------------
    # Install Completion
    # --------------------------------------------------------

    -install-completion)

        COMP_FILE="$HOME/.zephyrproject-completion.bash"
        cat <<'EOF_COMP' > "$COMP_FILE"
_zephyrproject_completion() {
    local cur prev words cword
    
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    local commands="-newproject -copy -import-cube -openproject -show -build -clean -flash -clean-flash -flash-only -debug -delete -install-completion -help"
    
    local apps_dir="${ZEPHYR_APPLICATIONS_DIR:-${ZEPHYR_WORKSPACE:-$HOME/zephyrproject}/applications}"

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return 0
    fi

    case "$prev" in
        -openproject|-delete|-copy)
            if [[ -d "$apps_dir" ]]; then
                local projects=$(find "$apps_dir" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null)
                COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
            fi
            return 0
            ;;
        -import-cube)
            COMPREPLY=( $(compgen -d -- "$cur") )
            return 0
            ;;
    esac

    return 0
}

complete -F _zephyrproject_completion zephyrproject
EOF_COMP

        if ! grep -q "source ~/.zephyrproject-completion.bash" "$HOME/.bashrc"; then
            echo -e "
# Zephyrproject bash completion
source ~/.zephyrproject-completion.bash
" >> "$HOME/.bashrc"
        fi

        success "Bash completion installed successfully!"
        warning "Please restart your terminal or run: source ~/.bashrc"
        ;;

    # --------------------------------------------------------
    # Delete Project
    # --------------------------------------------------------

    -delete)

        if [[ $# -ne 2 ]]; then
            error "Project name to delete must be provided."
            exit 1
        fi

        PROJECT_DIR="$APPLICATIONS_DIR/$2"

        if [[ ! -d "$PROJECT_DIR" ]]; then
            error "Project not found:"
            error "$PROJECT_DIR"
            exit 1
        fi

        warning "You are about to PERMANENTLY delete the project: $2"
        question "Are you sure? [y/N]: "
        read -r confirm
        if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
            rm -rf -- "$PROJECT_DIR"
            success "Project deleted: $2"
        else
            info "Deletion cancelled."
        fi
        ;;

    # --------------------------------------------------------
    # Open Project
    # --------------------------------------------------------

    -openproject)

        if [[ $# -ne 2 ]]; then

            error "Project name to open must be provided."
            exit 1
        fi

        PROJECT_DIR="$APPLICATIONS_DIR/$2"

        if [[ ! -d "$PROJECT_DIR" ]]; then

            error "Project not found:"
            error "$PROJECT_DIR"

            exit 1
        fi

        check_project

        if command -v code >/dev/null 2>&1; then

            info "Opening project in VS Code..."
            code "$PROJECT_DIR"

        else

            warning "VS Code 'code' command not found."
        fi

        activate_venv

        if [[ -n "$(get_board)" ]]; then

            info "Performing clean build..."
            run_build clean

        else

            warning "board.txt is empty."
            warning "Build not performed."
        fi

        ;;

    # --------------------------------------------------------
    # Show Projects
    # --------------------------------------------------------

    -show)

        mkdir -p "$APPLICATIONS_DIR"

        echo
        echo "Projects in Applications folder:"
        echo

        find "$APPLICATIONS_DIR" \
            -maxdepth 1 \
            -mindepth 1 \
            -type d \
            -printf '%f\n' |
            sort

        echo
        ;;

    # --------------------------------------------------------
    # Status
    # --------------------------------------------------------

    -status)

        check_project
        activate_venv
        show_status
        ;;

    # --------------------------------------------------------
    # Build
    # --------------------------------------------------------

    -build)

        check_project
        activate_venv

        run_build normal
        ;;

    # --------------------------------------------------------
    # Flash
    # --------------------------------------------------------

    -flash)

        check_project
        activate_venv

        run_build normal
        run_flash
        ;;

    # --------------------------------------------------------
    # Clean
    # --------------------------------------------------------

    -clean)

        check_project
        activate_venv

        run_build clean
        ;;

    # --------------------------------------------------------
    # Clean Flash
    # --------------------------------------------------------

    -clean-flash)

        check_project
        activate_venv

        run_build clean
        run_flash
        ;;

    # --------------------------------------------------------
    # Flash Only
    # --------------------------------------------------------

    -flash-only)

        check_project
        activate_venv

        run_flash
        ;;

    # --------------------------------------------------------
    # Debug
    # --------------------------------------------------------

    -debug)

        check_project
        activate_venv

        run_build normal
        run_debug
        ;;

    # --------------------------------------------------------
    # Debug Server
    # --------------------------------------------------------

    -debugserver)

        check_project
        activate_venv

        run_build normal
        run_debugserver
        ;;

    # --------------------------------------------------------
    # Menuconfig
    # --------------------------------------------------------

    -menuconfig)

        check_project
        activate_venv

        if [[ -z "$(get_board)" ]]; then

            error "Board not selected."
            error "board.txt is empty."

            exit 1
        fi

        # Configure/build if build does not exist
        if [[ ! -d "$PROJECT_DIR/$BUILD_DIR" ]]; then
            run_build normal
        fi

        info "Opening menuconfig..."

        west build \
            --build-dir "$PROJECT_DIR/$BUILD_DIR" \
            -t menuconfig

        ;;

    # --------------------------------------------------------
    # Pristine
    # --------------------------------------------------------

    -pristine)

        check_project

        if [[ -d "$PROJECT_DIR/$BUILD_DIR" ]]; then

            info "$PROJECT_DIR/$BUILD_DIR is being deleted..."

            rm -rf -- "$PROJECT_DIR/$BUILD_DIR"

            success "Build folder deleted."

        else

            warning "Build folder does not exist."
        fi

        ;;

    # --------------------------------------------------------
    # Unknown
    # --------------------------------------------------------

    *)

        error "Unknown command:"
        error "$ACTION"

        echo

        show_help

        exit 1
        ;;

esac